{
  "name": "daily-news",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cf": "opennextjs-cloudflare preview",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "db:migrate:local": "wrangler d1 migrations apply track-scan-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply track-scan-db --remote",
    "db:seed:local": "node scripts/seed-d1.mjs --local",
    "db:seed:remote": "node scripts/seed-d1.mjs --remote",
    "db:seed:sql": "node scripts/seed-d1.mjs --write",
    "db:rescore": "tsx scripts/rescore-d1.ts --local",
    "db:rescore:local": "tsx scripts/rescore-d1.ts --local",
    "db:rescore:remote": "tsx scripts/rescore-d1.ts --remote",
    "db:rescore:json": "tsx scripts/rescore-d1.ts --json-only"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.6.5",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "wrangler": "^4.36.0"
  }
}
